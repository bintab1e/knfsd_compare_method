{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One-time sealed holdout aggregate release",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "milestone_id", "evaluated_at", "sealed_holdout_commitment", "metrics"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "campaign_id": {"type": "string", "pattern": "^CAMPAIGN-[A-Z0-9-]+$"},
    "milestone_id": {"type": "string", "pattern": "^MILESTONE-[A-Z0-9-]+$"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "sealed_holdout_commitment": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": "number"},
      "minProperties": 1
    }
  }
}
