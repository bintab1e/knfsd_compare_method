{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private KNFSD root-cause-group dataset split",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "unit", "seed", "ratios", "target_implementation", "group_counts", "case_counts", "assignments", "external_analogue_case_ids", "source"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "unit": {"type": "string", "const": "root_cause_group"},
    "seed": {"type": "integer"},
    "ratios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "validation", "sealed_holdout"],
      "properties": {
        "development": {"type": "number"},
        "validation": {"type": "number"},
        "sealed_holdout": {"type": "number"}
      }
    },
    "target_implementation": {"type": "string", "const": "KNFSD"},
    "group_counts": {"$ref": "#/$defs/counts"},
    "case_counts": {"$ref": "#/$defs/counts"},
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_group_id", "case_ids", "strata", "partition"],
        "properties": {
          "case_group_id": {"type": "string", "pattern": "^GROUP-"},
          "case_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^CASE-KNFSD-"}},
          "strata": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}},
          "partition": {"enum": ["development", "validation", "sealed_holdout"]}
        }
      }
    },
    "external_analogue_case_ids": {"type": "array", "items": {"type": "string"}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "case_set_sha256", "config_sha256"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 0},
        "case_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "validation", "sealed_holdout"],
      "properties": {
        "development": {"type": "integer", "minimum": 0},
        "validation": {"type": "integer", "minimum": 0},
        "sealed_holdout": {"type": "integer", "minimum": 0}
      }
    }
  }
}
