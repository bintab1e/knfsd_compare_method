{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fast KNFSD rule plan and CodeQL artifact bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_plan", "codeql_artifact"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "rule_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern_id", "pattern_ir_version", "rule_plan_version", "codeql_support", "sources", "sinks", "flow_steps", "required_guards", "barriers", "scope_constraints", "rule_variants"],
      "properties": {
        "pattern_id": {"type": "string", "pattern": "^PATTERN-[A-Z0-9-]+$"},
        "pattern_ir_version": {"type": "integer", "minimum": 1},
        "rule_plan_version": {"type": "integer", "minimum": 1},
        "codeql_support": {"enum": ["direct", "approximate", "candidate_only", "unsupported"]},
        "sources": {"type": "array", "items": {"type": "string"}},
        "sinks": {"type": "array", "items": {"type": "string"}},
        "flow_steps": {"type": "array", "items": {"type": "string"}},
        "required_guards": {"type": "array", "items": {"type": "string"}},
        "barriers": {"type": "array", "items": {"type": "string"}},
        "scope_constraints": {"type": "array", "items": {"type": "string"}},
        "rule_variants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "tier", "protocol_scope", "processing_stage"],
            "properties": {
              "rule_id": {"type": "string"},
              "tier": {"enum": ["strict", "broad", "experimental"]},
              "protocol_scope": {"type": "array", "items": {"type": "string"}},
              "processing_stage": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "codeql_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "pattern_id", "pattern_ir_version", "rule_plan_version", "artifact_version", "status", "pack", "queries", "tests", "controls", "review_notes"],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0.0"},
        "pattern_id": {"type": "string", "pattern": "^PATTERN-[A-Z0-9-]+$"},
        "pattern_ir_version": {"type": "integer", "minimum": 1},
        "rule_plan_version": {"type": "integer", "minimum": 1},
        "artifact_version": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "const": "proposed"},
        "pack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "dependencies"],
          "properties": {
            "name": {"type": "string", "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$"},
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "dependencies": {
              "type": "object",
              "additionalProperties": false,
              "required": ["codeql/cpp-all"],
              "properties": {"codeql/cpp-all": {"type": "string"}}
            }
          }
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "rule_id", "tier", "query_kind", "content"],
            "properties": {
              "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.ql$"},
              "rule_id": {"type": "string", "minLength": 1},
              "tier": {"enum": ["strict", "broad", "experimental"]},
              "query_kind": {"enum": ["problem", "path-problem"]},
              "content": {"type": "string", "minLength": 1}
            }
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "content"],
            "properties": {
              "path": {"type": "string", "pattern": "^tests/[A-Za-z0-9_./-]+\\.(?:ql|qlref|cpp|c|h|expected)$"},
              "content": {"type": "string"}
            }
          }
        },
        "controls": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["control_id", "expectation", "description", "test_paths"],
            "properties": {
              "control_id": {"type": "string", "minLength": 1},
              "expectation": {"enum": ["hit", "no_hit"]},
              "description": {"type": "string", "minLength": 1},
              "test_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        },
        "review_notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
